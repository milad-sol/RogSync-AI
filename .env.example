# ──────────────────────────────────────────────
# RogSync AI — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Django
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Postgres (Docker Compose sets USE_POSTGRES=true and host to `db`)
USE_POSTGRES=false
POSTGRES_DB=rogsync
POSTGRES_USER=rogsync
POSTGRES_PASSWORD=rogsync
POSTGRES_PORT=5432
POSTGRES_HOST=

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Source WooCommerce (the site you fetch FROM)
WC_SOURCE_URL=https://source-store.example.com
WC_SOURCE_KEY=ck_xxxxxxxxxxxxxxxxxxxx
WC_SOURCE_SECRET=cs_xxxxxxxxxxxxxxxxxxxx

# Target WooCommerce (the site you push TO)
WC_TARGET_URL=https://target-store.example.com
WC_TARGET_KEY=ck_xxxxxxxxxxxxxxxxxxxx
WC_TARGET_SECRET=cs_xxxxxxxxxxxxxxxxxxxx

# OpenRouter API
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o
